# Registro local de actividad de los agentes (dashboard)
.claude/actividad/

# Secretos locales (Infrastructure): nunca al repositorio
.secrets/
*.secret
*.pem
*.key

# Dependencias instaladas por el servicio "deps" de compose.dev.yaml
node_modules/
.pnpm-store/

# Terraform (estado local, planes y variables con posibles secretos)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example

# Resultados de las ejecuciones de tests (T-35): informes, trazas y vídeos
tests/results/*
!tests/results/.gitkeep

# Ficheros de entorno locales: nunca al repositorio (solo los .example)
.env
.env.*
!.env.example
