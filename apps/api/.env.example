# Ejemplo de configuración de la API (apps/api/src/config.ts, docs/arquitectura.md §10.1).
#
# IMPORTANTE:
# - La API NO lee ficheros .env: toma las variables del entorno del proceso.
#   En DEV y TESTING ya las pone compose (ancla `x-api-env` de compose.dev.yaml).
#   Este fichero sirve de referencia, o para exportarlas a mano:
#     cp apps/api/.env.example apps/api/.env.local   # .env.local no se sube a git
#     set -a; . apps/api/.env.local; set +a
# - Los SECRETOS nunca van aquí como valor: se pasan como RUTA a un fichero
#   (variables *_FILE). En DEV los genera `sh deploy/dev/generar-secretos.sh`
#   en `.secrets/dev/` (permisos 0600, fuera de git).

# --- Servidor ----------------------------------------------------------------
# IP en la que escucha (por defecto 0.0.0.0).
HOST=0.0.0.0
# Puerto HTTP (1025–65535, por defecto 3000).
PORT=3000
# Puerto de /metrics (1025–65535, distinto de PORT; por defecto 9464).
METRICS_PORT=9464
# Nivel de log: trace, debug, info, warn, error, fatal (por defecto info).
LOG_LEVEL=debug
# Origen público exacto, esquema://host[:puerto], sin ruta ni barra final.
# En DEV es el servidor Vite.
PUBLIC_ORIGIN=http://localhost:5173
# IPs o CIDR (IPv4 /24–/32, IPv6 /120–/128) del proxy cuyo X-Forwarded-For se
# acepta, separados por comas. Vacío = no se confía en nadie (DEV, sin Caddy).
TRUSTED_PROXIES=

# --- Entorno y versión (aparecen en los logs) --------------------------------
NODE_ENV=development
# APP_ENV: dev, test, demo o prod.
APP_ENV=dev
APP_VERSION=dev
TZ=UTC

# --- Instalación (valores fijos del MVP, supuesto 20) ------------------------
# Número de mesas (1–99, por defecto 20).
TABLE_COUNT=20
# Minutos para marcar un pedido como retrasado (1–60, por defecto 10).
DELAY_THRESHOLD_MINUTES=10
# Duración máxima de la sesión en horas (1–12, por defecto 12).
SESSION_MAX_HOURS=12

# --- Base de datos -----------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cafeteria
DATABASE_USER=app_rw
# Ruta al fichero con la contraseña (obligatoria).
DATABASE_PASSWORD_FILE=.secrets/dev/db_app_password

# --- Secretos de la aplicación (rutas a ficheros) ----------------------------
# Pepper del hash de los PIN: al menos 32 bytes.
PIN_PEPPER_FILE=.secrets/dev/pin_pepper
# Solo para el comando create-initial-manager: nombre y PIN del primer encargado.
# Déjalas vacías para arrancar la API normalmente.
INITIAL_MANAGER_NAME_FILE=
INITIAL_MANAGER_PIN_FILE=
