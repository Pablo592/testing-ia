# Imagen de HERRAMIENTAS de desarrollo (solo DEV, nunca se despliega).
#
# Contiene Node.js LTS + pnpm para ejecutar, con el código montado desde el
# host, el servidor de la API en modo watch, el servidor de Vite, las
# migraciones y la instalación de dependencias. No contiene código de la app
# ni secretos. TESTING/DEMO/PROD usan la imagen final multi-stage (distroless)
# que se definirá en deploy/app/Containerfile (ver docs/infraestructura.md).
#
# Construir (rootless, sin sudo):
#   podman-compose -f compose.dev.yaml build
#
# Imagen base fijada por digest (índice multi-arquitectura de node:26.13.1-alpine,
# Node 26 = LTS activa "Lithium"). Para actualizar: consultar el nuevo digest y
# cambiar la línea FROM; ver docs/infraestructura.md §8.
FROM docker.io/library/node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5

# Versión exacta de pnpm. Debe coincidir con "packageManager" del package.json
# raíz cuando el Developer lo cree. Node >= 25 ya no trae corepack, por eso se
# instala con npm en tiempo de construcción.
ARG PNPM_VERSION=12.21.0

# Único paso como root: solo en construcción (rootless), nunca en ejecución.
RUN npm install --global --no-fund --no-audit "pnpm@${PNPM_VERSION}" \
 && npm cache clean --force \
 && mkdir -p /workspace /pnpm-store \
 && chown 1000:1000 /workspace /pnpm-store

# El usuario "node" de la imagen oficial tiene UID/GID 1000.
USER 1000:1000
WORKDIR /workspace

# Con --read-only, HOME y cachés van a /tmp (tmpfs).
ENV HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    HEALTHCHECK_URL=http://127.0.0.1:3000/healthz

# Forma exec (sin shell). Cada servicio de compose ajusta HEALTHCHECK_URL o
# desactiva el healthcheck si es un proceso de una sola ejecución.
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
  CMD ["node", "-e", "fetch(process.env.HEALTHCHECK_URL).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]

CMD ["node", "--version"]
